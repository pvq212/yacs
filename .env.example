# =====================================================================
# YACS 環境設定範例
# ---------------------------------------------------------------------
# 複製為 .env 後修改。此檔不含任何真實秘密；正式環境請務必：
#   - APP_ENV=production、APP_DEBUG=false、HTTPS、SESSION_SECURE_COOKIE=true
#   - 以 `php artisan yacs:generate-keys` 產生各項金鑰
#   - 資料庫、Redis、物件儲存不對公網開放
# 詳細說明見 docs/manual/zh-TW/configuration.md
# =====================================================================

APP_NAME=YACS
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
# 反向代理（Caddy/Nginx）位址，逗號分隔；未設定則不信任 X-Forwarded-*。
YACS_TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# PostgreSQL（ADR-0004）：runtime 與 migration 使用不同角色
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=yacs
DB_USERNAME=yacs_runtime
DB_PASSWORD=runtime-dev-only
DB_MIGRATOR_USERNAME=yacs_owner
DB_MIGRATOR_PASSWORD=owner-dev-only
# 僅 docker compose 首次初始化資料庫時使用（superuser）。
YACS_DB_SUPERUSER_PASSWORD=postgres-dev-only

# ---------------------------------------------------------------------
# Redis（ADR-0003）：佇列與快取分開 instance
# ---------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=
REDIS_PREFIX=yacs:

QUEUE_CONNECTION=core
YACS_QUEUE_CORE_RETRY_AFTER=120
YACS_QUEUE_AI_RETRY_AFTER=120
YACS_QUEUE_KB_RETRY_AFTER=330
YACS_QUEUE_EVENTS_RETRY_AFTER=120
YACS_QUEUE_CHANNELS_RETRY_AFTER=90

CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=yacs_session
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------
# Reverb（即時推送）
# 應用程式透過內部位址發佈；瀏覽器透過 VITE_REVERB_* 公開位址連線。
# ---------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=yacs
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
YACS_PUBLIC_REVERB_HOST=localhost
YACS_PUBLIC_REVERB_PORT=8080
YACS_PUBLIC_REVERB_SCHEME=http

# ---------------------------------------------------------------------
# 安全金鑰（皆為 base64 的 32 bytes；以 php artisan yacs:generate-keys 產生）
# ---------------------------------------------------------------------
# envelope encryption 主金鑰（provider key、webhook secret、MFA secret 等）
YACS_SECRET_KEY_ID=k1
YACS_SECRET_ENCRYPTION_KEY=
# 個資查詢 digest 金鑰（email lookup）
YACS_LOOKUP_DIGEST_KEY=
# MFA 強制：off | all（正式環境建議 all）
YACS_MFA_ENFORCEMENT=off

# ---------------------------------------------------------------------
# 物件儲存（ADR-0007）：開發用 SeaweedFS；正式建議 Cloudflare R2
# ---------------------------------------------------------------------
YACS_FILES_DISK=private
AWS_ACCESS_KEY_ID=yacs-dev-access
AWS_SECRET_ACCESS_KEY=yacs-dev-secret-not-for-production
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=yacs-dev
AWS_ENDPOINT=http://s3:8333
# 瀏覽器直傳用的公開 endpoint（開發時為本機 port）
YACS_S3_PUBLIC_ENDPOINT=http://localhost:8333
AWS_USE_PATH_STYLE_ENDPOINT=true
# Cloudflare R2 範例：
#   AWS_DEFAULT_REGION=auto
#   AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   YACS_S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AWS_USE_PATH_STYLE_ENDPOINT=true
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
YACS_FILE_SCANNER=content_validation

# ---------------------------------------------------------------------
# AI（預設關閉；供應商金鑰於後台設定並加密保存，不寫在這裡）
# ---------------------------------------------------------------------
YACS_AI_DEFAULT_MODE=disabled
YACS_AI_DAILY_CALL_BUDGET=1000
YACS_PROVIDER_DEBUG_RETENTION_DAYS=0
# 開發/測試允許連線到 http 或本機目的地（例如 fake-ai、ollama）；正式環境必須為 false
YACS_EGRESS_ALLOW_INSECURE_FOR_TESTING=false
# platform operator 批准的內網目的地（host:port，逗號分隔）
YACS_EGRESS_APPROVED_PRIVATE_TARGETS=

# ---------------------------------------------------------------------
# 郵件（開發用 Mailpit：http://localhost:8025）
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@yacs.test
MAIL_FROM_NAME="${APP_NAME}"

# docker compose 對外 port
YACS_APP_PORT=8000
YACS_REVERB_PORT=8080
YACS_PG_PORT=54320
YACS_REDIS_QUEUE_PORT=63790
YACS_REDIS_CACHE_PORT=63791
YACS_MAILPIT_PORT=8025
YACS_S3_PORT=8333
