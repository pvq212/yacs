{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "lib": ["ES2022", "DOM"],
        "types": ["vite/client", "node"],
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "packages/**/*.ts",
        "vite*.ts",
        "tests/browser/**/*.ts"
    ]
}
