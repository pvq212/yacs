{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.sdk.ts",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "types:api": "openapi-typescript docs/spec/contracts/openapi.json -o resources/js/generated/api.d.ts && node scripts/generate-contracts.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "pusher-js": "^8.6.0",
    "vue": "^3.5.43"
  }
}
