# Design template only. The coding agent must implement the corresponding configuration.
# Never deploy production using this file unchanged. No real secrets are included.
APP_NAME=SupportDesk
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://supportdesk.test
APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=supportdesk_local
DB_USERNAME=supportdesk_runtime
DB_PASSWORD=

# Laravel config must define these queue connections separately.
QUEUE_CONNECTION=redis_core
REDIS_CLIENT=phpredis
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=
SUPPORTDESK_QUEUE_CORE_RETRY_AFTER=120
SUPPORTDESK_QUEUE_AI_RETRY_AFTER=120
SUPPORTDESK_QUEUE_KB_RETRY_AFTER=330

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Public browser endpoint differs from the private application publishing endpoint.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=supportdesk.test
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http

SESSION_DRIVER=database
SESSION_TABLE=sessions
SESSION_ENCRYPT=true
SESSION_COOKIE=supportdesk_session
SESSION_SECURE_COOKIE=false
# Production: secure=true, debug=false, HTTPS, approved origins and private database/Redis.
SUPPORTDESK_AI_DEFAULT_MODE=disabled
SUPPORTDESK_PROVIDER_DEBUG_RETENTION_DAYS=0
SUPPORTDESK_SECRET_KEY_ID=
SUPPORTDESK_SECRET_ENCRYPTION_KEY=
SUPPORTDESK_IDENTITY_SIGNING_KEY_BASE64=

FILESYSTEM_DISK=private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Choose one real provider only after configuration/probe; blank keys are valid when AI is off.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MAIL_MAILER=log
