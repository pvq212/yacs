        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_seq": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "client_message_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "author_type": {
          "type": "string",
          "enum": [
            "visitor",
            "staff",
            "ai",
            "system"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "attachment",
            "system"
          ]
        },
        "body_text": {
          "type": "string",
          "maxLength": 8000
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attachment"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "redacted": {
          "type": "boolean"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        }
